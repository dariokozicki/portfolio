---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = site.title,
  description = site.description,
  image = '/og.png',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#f4f2ec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111210" media="(prefers-color-scheme: dark)" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Darío Kozicki — Writing" href="/rss.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header page-shell">
      <a class="wordmark" href="/" aria-label="Darío Kozicki, home">Darío Kozicki</a>
      <nav aria-label="Primary navigation">
        <a href="/#work">Work</a>
        <a href="/writing/">Writing</a>
        <a href="/about/">About</a>
        <a href={site.resume} target="_blank" rel="noreferrer">Résumé <span aria-hidden="true">↗</span></a>
      </nav>
    </header>
    <main id="content"><slot /></main>
    <footer class="site-footer page-shell">
      <p>Cloud · Systems · Product engineering</p>
      <div>
        <a href={site.github}>GitHub</a>
        <a href={site.linkedin}>LinkedIn</a>
        <a href={`mailto:${site.email}`}>Email</a>
      </div>
    </footer>
  </body>
</html>
