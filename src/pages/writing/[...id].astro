---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DependencyMapSketch from '../../components/DependencyMapSketch.astro';
import ModernizationSketch from '../../components/ModernizationSketch.astro';
import TrafficSurgeSketch from '../../components/TrafficSurgeSketch.astro';

export async function getStaticPaths() {
  const articles = await getCollection('writing', ({ data }) => import.meta.env.DEV || !data.draft);
  return articles.map((article) => ({ params: { id: article.id }, props: { article } }));
}

interface Props { article: CollectionEntry<'writing'> }
const { article } = Astro.props;
const { Content } = await render(article);
const published = new Intl.DateTimeFormat('en', { dateStyle: 'long' }).format(article.data.publishedAt);
---
<BaseLayout title={`${article.data.title} — Darío Kozicki`} description={article.data.description}>
  <article class="page-shell article-page">
    <header class="article-header">
      <a class="back-link" href="/writing/">← Writing</a>
      <h1>{article.data.title}</h1>
      <p>{article.data.description}</p>
      <div><time datetime={article.data.publishedAt.toISOString()}>{published}</time><span>{article.data.topics.join(' · ')}</span></div>
    </header>
    <div class="prose">
      <Content />
      {article.id === 'incremental-modernization' && <ModernizationSketch />}
      {article.id === 'incremental-modernization' && <DependencyMapSketch />}
      {article.id === 'high-traffic-platforms' && <TrafficSurgeSketch />}
    </div>
  </article>
</BaseLayout>
